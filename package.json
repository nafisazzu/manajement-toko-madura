{
  "name": "toko-madura-web",
  "version": "1.0.0",
  "private": true,
  "description": "Toko Madura - pencatatan barang masuk & keluar (Praktikum Pemrograman Web, Week 2-7)",
  "scripts": {
    "build:week3": "tailwindcss -i week3/src/input.css -o week3/dist/output.css --minify",
    "build:week4": "tailwindcss -i week4/src/input.css -o week4/dist/output.css --minify",
    "build:week5": "tailwindcss -i week5/src/input.css -o week5/dist/output.css --minify",
    "build:week6": "tailwindcss -i week6/src/input.css -o week6/dist/output.css --minify",
    "build:week7": "tailwindcss -i week7/src/input.css -o week7/public/css/output.css --minify",
    "build": "npm run build:week3 && npm run build:week4 && npm run build:week5 && npm run build:week6 && npm run build:week7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}